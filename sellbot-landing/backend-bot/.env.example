# ================================================================
# SELLBOT / ASISTENLAPAK PLATFORM - ENVIRONMENT VARIABLES TEMPLATE
# Salin file ini menjadi .env di dalam folder: sellbot-landing/backend-bot/.env
# ================================================================

# Port server Express
PORT=3001
NODE_ENV=production

# Supabase Database & Auth (Wajib)
# Dapatkan di: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# AI Engines API Keys
# Gemini API Key: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Opsional / Fallback LLM): https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Ekspedisi & Ongkos Kirim (RajaOngkir / Komerce)
RAJAONGKIR_API_KEY=your_rajaongkir_or_komerce_api_key
STORE_ORIGIN_ID=254

# Midtrans Payment Gateway
# Dapatkan di: https://dashboard.midtrans.com/
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Mxxxxxxxx
MIDTRANS_IS_PRODUCTION=true
